PORT=3000
NODE_ENV=development
GIRO_DATA_DIR=

# URL pública usada nos links de redefinição de senha.
APP_URL=http://localhost:3000

# SMTP usado para envio real dos e-mails de recuperação.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GIRO <no-reply@example.com>"

# Política dos tokens e proteção contra abuso.
PASSWORD_RESET_TOKEN_MINUTES=60
PASSWORD_RESET_RATE_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_MAX=5
