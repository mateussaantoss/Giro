PORT=3000
NODE_ENV=development
GIRO_DATA_DIR=

# Integração n8n/Evolution. Nunca publique valores reais.
N8N_API_TOKEN=
N8N_WORKSHOP_ID=
# Teste opcional enviando mensagem para o próprio número. Só processa mensagens
# fromMe que começam com N8N_TEST_PREFIX, evitando loop de respostas.
N8N_TEST_PHONE=
N8N_TEST_PREFIX=#giro

# MySQL 8+ (o schema está em database/schema.sql).
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# URL pública usada nos links de redefinição de senha.
APP_URL=http://localhost:3000

# SMTP usado para envio real dos e-mails de recuperação.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GIRO <no-reply@example.com>"
# Destinatário das solicitações do formulário. Se vazio, usa SMTP_USER.
LEADS_TO_EMAIL=leads@example.com

# Política dos tokens e proteção contra abuso.
PASSWORD_RESET_TOKEN_MINUTES=60
PASSWORD_RESET_RATE_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_MAX=5
